# Copy these public browser values from Firebase Console > Project settings >
# Your apps > Web app > SDK setup and configuration > Config. Do not use values
# from an Android google-services.json file; a Web app ID contains ":web:".
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:1234567890:web:replace-with-your-web-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890

# VITE_* values are embedded in the browser bundle at build time. Never put
# Firebase Admin service-account JSON or any backend secret in these variables.
