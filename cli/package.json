{
  "name": "@swiveltechnologies/swico",
  "version": "0.1.0",
  "description": "Swico terminal client for authenticated Chat",
  "type": "module",
  "bin": {
    "swico": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "release:check": "npm run build && node scripts/release-check.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "typescript": "5.7.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/swivelit/ai_tool.git",
    "directory": "cli"
  },
  "homepage": "https://swico.in",
  "bugs": {
    "url": "https://github.com/swivelit/ai_tool/issues"
  },
  "keywords": [
    "swico",
    "ai",
    "chat",
    "terminal"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "2.0.0",
    "zod": "^3.25.76"
  }
}
