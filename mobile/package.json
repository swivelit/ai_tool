{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "native:prepare": "npm run release:verify-backend-first",
    "android": "npm run native:prepare && expo run:android",
    "ios": "npm run native:prepare && expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "eval:golden": "vitest run test/goldenAssistant.eval.test.ts test/goldenVoice.eval.test.ts --reporter=verbose",
    "test:profiler": "vitest run test/localAgents.profiler.test.ts",
    "test:local-agents": "vitest run test/localAgents.*.test.ts",
    "prebuild": "npm run native:prepare && expo prebuild",
    "android:native": "npm run native:prepare && expo run:android",
    "ios:native": "npm run native:prepare && expo run:ios",
    "eas-build-pre-install": "node ./scripts/sync-llama-cpp.js",
    "native:sync-llama": "node ./scripts/sync-llama-cpp.js",
    "native:verify-llama": "node ./scripts/verify-native-llama-runtime.js",
    "release": "npm run release:verify-backend-first",
    "release:verify-backend-first": "node ./scripts/verify-release-backend-first-config.js",
    "smoke:chat": "node ./scripts/smoke-chat-10.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.25",
    "expo-asset": "~12.0.12",
    "expo-auth-session": "~7.0.10",
    "expo-av": "~16.0.7",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.10",
    "expo-crypto": "~15.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.9",
    "expo-notifications": "~0.32.15",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.15",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech-recognition": "^3.1.2",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-web-browser": "~15.0.9",
    "firebase": "^12.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "modules"
    }
  }
}
