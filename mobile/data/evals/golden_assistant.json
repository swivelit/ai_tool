    {
      "id": "reminder_create_call_011",
      "surface": "mobile_local_agent",
      "prompt": "Remind me to call Sam tomorrow at 9 AM",
      "userId": 9011,
      "replyLanguage": "en",
      "mocks": {
        "reminder": {
          "title": "Call Sam",
          "details": "Call Sam",
          "datetimeText": "tomorrow at 9 AM",
          "assistantReply": "Okay, I can set a reminder for Call Sam tomorrow at 9 AM."
        }
      },
      "expected": {
        "route": "reminder_create",
        "intent": "reminder",
        "tools": ["createReminder"],
        "language": "en",
        "answerIncludes": ["Call Sam"],
        "noBackendCall": true
      }
    },

