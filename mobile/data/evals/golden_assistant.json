{
  "version": 1,
  "description": "Deterministic golden prompts for assistant intelligence, routing, safety, local-first, RAG, cache, and voice regressions.",
  "cases": [
    {
      "id": "greeting_name_en_001",
      "surface": "mobile_local_agent",
      "prompt": "hello",
      "userId": 9001,
      "userProfile": { "name": "Hari" },
      "expected": {
        "route": "fast_greeting",
        "source": "local_rules",
        "language": "en",
        "answerIncludes": ["Hari"],
        "noBackendCall": true
      }
    },

    {
