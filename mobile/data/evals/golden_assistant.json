      "surface": "mobile_local_agent",
      "prompt": "What is the weather?",
      "userId": 9006,
      "userProfile": { "place": "Chennai" },
      "mocks": {
        "weather": {
          "name": "Chennai",
          "country": "India",
          "temperature": 31,
          "feelsLike": 35,
          "weatherCode": 1,
          "wind": 12
        }
      },
      "expected": {
        "route": "weather",
        "tools": ["getWeather"],
        "language": "en",
        "answerIncludes": ["Chennai"],
        "noBackendCall": true
      }
    },

    {
      "id": "reminder_create_call_011",
      "surface": "mobile_local_agent",
      "prompt": "Remind me to call Sam tomorrow at 9 AM",
      "userId": 9011,
      "replyLanguage": "en",
      "mocks": {
        "reminder": {
          "title": "Call Sam",
          "details": "Call Sam",
          "datetimeText": "tomorrow at 9 AM",
          "assistantReply": "Okay, I can set a reminder for Call Sam tomorrow at 9 AM."
        }
      },
      "expected": {
        "route": "reminder_create",
        "intent": "reminder",
        "tools": ["createReminder"],
        "language": "en",
        "answerIncludes": ["Call Sam"],
        "noBackendCall": true
      }
    },

    {
