    {
      "id": "semantic_cache_high_confidence_stable_043",
      "surface": "mobile_local_agent",
      "prompt": "Explain local-first routing",
      "userId": 9043,
      "replyLanguage": "en",
      "fixtures": {
        "semanticCache": {
          "sourceQuestion": "Explain local-first routing",
          "answer": "Local-first routing keeps phone-local handling primary.",
          "route": "local_answer",
          "confidence": 0.98
        }
      },
      "expected": {
        "route": "semantic_cache",
        "cacheHit": true,
        "cacheConfidenceMin": 0.95,
        "answerIncludes": ["phone-local"],
        "noBackendCall": true
      }
    },

