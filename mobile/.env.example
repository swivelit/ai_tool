# Jai mobile local-first runtime configuration.
# Copy to .env.local for development or set these in EAS/CI for release.
# EXPO_PUBLIC_* values are bundled into the app; do not put long-lived secrets here.

# Text chat is local-first by default.
EXPO_PUBLIC_USE_LOCAL_CHAT_PIPELINE=true

# Recorded voice must default to the same local-first workflow as text chat.
# Production/release verification fails if this is disabled.
EXPO_PUBLIC_USE_LOCAL_VOICE_PIPELINE=true

# Production/release must use native_on_device. The local_adapter mode is dev-only.
EXPO_PUBLIC_LOCAL_MODEL_RUNTIME_MODE=native_on_device
EXPO_PUBLIC_LOCAL_MODEL_DELIVERY_MODE=download_on_first_launch
EXPO_PUBLIC_LOCAL_ON_DEVICE_BACKEND=llama_cpp
EXPO_PUBLIC_LOCAL_ON_DEVICE_NATIVE_MODULE=JaiOnDeviceModel
EXPO_PUBLIC_LOCAL_ON_DEVICE_MODEL_ROOT=document://models

# Production/release GGUF delivery: choose one CDN base URL OR all per-model URLs.
# Option A: one public CDN base URL used with cdn://models/<fileName> in models.json.
EXPO_PUBLIC_LOCAL_MODEL_CDN_BASE_URL=

# Option B: per-model public/signed URLs generated by the release pipeline.
EXPO_PUBLIC_LOCAL_MODEL_URL_GEMMA_4B=
EXPO_PUBLIC_LOCAL_MODEL_URL_QWEN_8B=
EXPO_PUBLIC_LOCAL_MODEL_URL_QWEN_14B=
EXPO_PUBLIC_LOCAL_MODEL_URL_QWEN_EMBED=

# Exact byte sizes of the GGUF files users will download. Required for release.
EXPO_PUBLIC_LOCAL_MODEL_BYTES_GEMMA_4B=
EXPO_PUBLIC_LOCAL_MODEL_BYTES_QWEN_8B=
EXPO_PUBLIC_LOCAL_MODEL_BYTES_QWEN_14B=
EXPO_PUBLIC_LOCAL_MODEL_BYTES_QWEN_EMBED=

# SHA-256 hashes of the exact GGUF files users will download. Required for release.
EXPO_PUBLIC_LOCAL_MODEL_SHA256_GEMMA_4B=
EXPO_PUBLIC_LOCAL_MODEL_SHA256_QWEN_8B=
EXPO_PUBLIC_LOCAL_MODEL_SHA256_QWEN_14B=
EXPO_PUBLIC_LOCAL_MODEL_SHA256_QWEN_EMBED=

# Development-only local adapter. Do not use in production/release builds.
# EXPO_PUBLIC_LOCAL_MODEL_RUNTIME_MODE=local_adapter
# EXPO_PUBLIC_LOCAL_MODEL_BASE_URL=http://192.168.1.23:10000/v1
# EXPO_PUBLIC_LOCAL_MODEL_ADAPTER_LOCATION=external_lan
# EXPO_PUBLIC_LOCAL_MODEL_ALLOW_DEVICE_LOOPBACK=false

# llama.cpp checkout for CI/build machines. Prefer the committed submodule path.
# JAI_LLAMA_CPP_DIR=/absolute/path/to/llama.cpp
# JAI_LLAMA_CPP_REF=<tag-or-commit>
