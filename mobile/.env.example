# Jai mobile backend-first runtime configuration.
# Copy to .env.local for development or set these in EAS/CI for release.
# EXPO_PUBLIC_* values are bundled into the app; do not put long-lived secrets here.

# Firebase Auth project config used by app.config.ts and lib/firebase.ts.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Native Android Firebase config for Expo prebuild/release builds.
# Valid options:
# A. Place mobile/google-services.json locally.
# B. Set one of the JSON secret env vars below.
# C. Set all six EXPO_PUBLIC_FIREBASE_* values above and let
#    scripts/ensure-google-services-json.js synthesize the ignored local file.
# The JSON file is gitignored and must not be committed.
GOOGLE_SERVICES_JSON_BASE64=
# GOOGLE_SERVICES_JSON=
# FIREBASE_GOOGLE_SERVICES_JSON=

# Local debug without real Firebase native config:
# EXPO_PUBLIC_E2E_MOCK_AUTH=1
# JAI_DEBUG_LITE=1

# Google sign-in OAuth client IDs used by app.config.ts and AuthProvider.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Backend AI router is primary; local model is optional fallback/dev only.
EXPO_PUBLIC_ENABLE_LOCAL_MODEL_FALLBACK=false
EXPO_PUBLIC_USE_LOCAL_CHAT_PIPELINE=false

# Recorded voice defaults to authenticated backend Sarvam STT/TTS.
# Enable only for explicit development of local native STT fallback.
EXPO_PUBLIC_USE_LOCAL_VOICE_PIPELINE=false

# Local model fallback/dev settings. These are ignored for normal public
# backend-first release builds unless EXPO_PUBLIC_ENABLE_LOCAL_MODEL_FALLBACK=true
# or EXPO_PUBLIC_USE_LOCAL_CHAT_PIPELINE=true.
EXPO_PUBLIC_LOCAL_MODEL_RUNTIME_MODE=native_on_device
EXPO_PUBLIC_LOCAL_MODEL_DELIVERY_MODE=download_on_first_launch
EXPO_PUBLIC_LOCAL_ON_DEVICE_BACKEND=llama_cpp
EXPO_PUBLIC_LOCAL_ON_DEVICE_NATIVE_MODULE=JaiOnDeviceModel
EXPO_PUBLIC_LOCAL_ON_DEVICE_MODEL_ROOT=document://models

# For low-memory Android emulator smoke tests:
# JAI_DEBUG_LITE=1 ./launch-debug_apk.sh
# This uses:
# EXPO_PUBLIC_LOCAL_MODEL_RUNTIME_MODE=local_adapter
# EXPO_PUBLIC_LOCAL_MODEL_DELIVERY_MODE=local_adapter_dev
# Debug-only. Do not use debug-lite/local_adapter_dev for production/release.

# Explicit local fallback release GGUF delivery: choose one CDN base URL OR all
# per-model URLs. Not required for backend-first release builds.
# Option A: one public CDN base URL used with cdn://models/<fileName> in models.json.
EXPO_PUBLIC_LOCAL_MODEL_CDN_BASE_URL=

# Option B: per-model public/signed URLs generated by the release pipeline.
EXPO_PUBLIC_LOCAL_MODEL_URL_GEMMA_4B=
EXPO_PUBLIC_LOCAL_MODEL_URL_QWEN_8B=
EXPO_PUBLIC_LOCAL_MODEL_URL_QWEN_14B=
EXPO_PUBLIC_LOCAL_MODEL_URL_QWEN_EMBED=

# Exact byte sizes of the GGUF files users will download. Required only for
# explicit local fallback release builds.
EXPO_PUBLIC_LOCAL_MODEL_BYTES_GEMMA_4B=
EXPO_PUBLIC_LOCAL_MODEL_BYTES_QWEN_8B=
EXPO_PUBLIC_LOCAL_MODEL_BYTES_QWEN_14B=
EXPO_PUBLIC_LOCAL_MODEL_BYTES_QWEN_EMBED=

# SHA-256 hashes of the exact GGUF files users will download. Required only for
# explicit local fallback release builds.
EXPO_PUBLIC_LOCAL_MODEL_SHA256_GEMMA_4B=
EXPO_PUBLIC_LOCAL_MODEL_SHA256_QWEN_8B=
EXPO_PUBLIC_LOCAL_MODEL_SHA256_QWEN_14B=
EXPO_PUBLIC_LOCAL_MODEL_SHA256_QWEN_EMBED=

# Development-only local adapter. Do not use in production/release builds.
# EXPO_PUBLIC_LOCAL_MODEL_RUNTIME_MODE=local_adapter
# EXPO_PUBLIC_LOCAL_MODEL_BASE_URL=http://192.168.1.23:10000/v1
# EXPO_PUBLIC_LOCAL_MODEL_ADAPTER_LOCATION=external_lan
# EXPO_PUBLIC_LOCAL_MODEL_ALLOW_DEVICE_LOOPBACK=false

# llama.cpp checkout for CI/build machines. Prefer the committed submodule path.
# JAI_LLAMA_CPP_DIR=/absolute/path/to/llama.cpp
# JAI_LLAMA_CPP_REF=<tag-or-commit>

# Backend chat smoke test. Real backend mode requires Firebase bearer auth.
SMOKE_CHAT_BASE_URL=
SMOKE_CHAT_USE_MOCK=false
SMOKE_CHAT_AUTH_TOKEN=
SMOKE_CHAT_FIREBASE_API_KEY=
SMOKE_CHAT_FIREBASE_EMAIL=
SMOKE_CHAT_FIREBASE_PASSWORD=
SMOKE_CHAT_ENSURE_USER=false
SMOKE_CHAT_USER_NAME=Smoke Test User
SMOKE_CHAT_TIMEZONE=Asia/Kolkata
SMOKE_CHAT_ASSISTANT_NAME=Elli
SMOKE_CHAT_REPLY_LANGUAGE=en
