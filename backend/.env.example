# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
# Production/Render should leave this false by default. Set true only for
# short-lived debugging when redacted question/answer previews are acceptable.
LOG_CHAT_CONTENT=false
LOG_CHAT_CONTENT_MAX_CHARS=240
CLIENT_TURN_LOGS_ENABLED=true
CHAT_TURN_SUMMARY_LOGS_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_JSON_MODEL=gpt-5-nano
OPENAI_MODEL_CHEAP=gpt-5-nano
OPENAI_MODEL_STANDARD=gpt-5-nano
OPENAI_MODEL_REASONING=gpt-5-mini
OPENAI_MODEL_HIGH=
OPENAI_API_MODE=auto
OPENAI_MODEL_CHEAP_PRIMARY=gpt-5-nano
OPENAI_MODEL_CHEAP_FALLBACKS=gpt-4.1-nano,gpt-4o-mini
OPENAI_MODEL_REASONING_LIGHT_PRIMARY=gpt-4.1-mini
OPENAI_MODEL_REASONING_PRIMARY=gpt-5-mini
OPENAI_MODEL_REASONING_FALLBACKS=gpt-4.1-mini,gpt-4o-mini
OPENAI_MODEL_HARD_REASONING=o4-mini
OPENAI_ENABLE_O_SERIES_FOR_FREE=false
# Deprecated snapshot; production validation requires this to remain false.
OPENAI_ENABLE_GPT35_EMERGENCY_FALLBACK=false
OPENAI_DISABLED_MODELS=
OPENAI_MODEL_PROBE_CACHE_TTL_SECONDS=900
# Backend-only branded web routing. Never copy model IDs into web/VITE values.
SWICO_DEFAULT_TIER=lite
SWICO_TIER_SELECTION_ENABLED=true
SWICO_PRO_ENABLED=false
SWICO_FREE_ENABLED=false
SWICO_FREE_INFERENCE_BASE_URL=
SWICO_FREE_INFERENCE_TOKEN=
SWICO_FREE_INFERENCE_TIMEOUT_SECONDS=90
SWICO_FREE_CONNECT_RETRIES=2
SWICO_FREE_EMBEDDING_DIMENSIONS=384
SWICO_FREE_MAX_QUEUE_WAIT_SECONDS=15
SWICO_FREE_MAX_TOTAL_REQUEST_SECONDS=45
SWICO_FREE_DURABLE_QUEUE_ENABLED=false
SWICO_FREE_QUEUE_WORKER_ENABLED=false
SWICO_FREE_QUEUE_POLL_SECONDS=0.25
SWICO_FREE_QUEUE_STALE_RUNNING_SECONDS=120
SWICO_FREE_ROLLOUT_PERCENT=0
SWICO_FREE_RATE_LIMIT_PER_MINUTE=2
SWICO_FREE_DAILY_MESSAGE_LIMIT=10
SWICO_FREE_MAX_OUTPUT_TOKENS=256
# Website guest sessions are separate from Firebase users. Raw tokens are
# never persisted; the session TTL and admission guard are server-side only.
SWICO_GUEST_SESSION_TTL_SECONDS=86400
SWICO_GUEST_SESSION_CREATION_RATE_LIMIT_PER_HOUR=10
# Optional dedicated key for the one-way guest network scope hash. If empty,
# DOWNLOAD_TOKEN_SECRET or SECRET_KEY is used.
SWICO_GUEST_SCOPE_HASH_SECRET=
SWICO_TRUSTED_PROXY_HOPS=0
SWICO_LITE_MODEL_PRIMARY=gpt-5.4-mini
SWICO_LITE_MODEL_FALLBACKS=gpt-5.4-nano
SWICO_STANDARD_MODEL_PRIMARY=gpt-5.6-terra
SWICO_STANDARD_MODEL_FALLBACKS=gpt-5.5
SWICO_PRO_MODEL_PRIMARY=gpt-5.6-sol
SWICO_PRO_MODEL_FALLBACKS=gpt-5.6-terra
# Website-only adaptive provider pool. Keep false until aliases are validated
# in a controlled rollout; Free never uses these aliases.
WEB_MULTI_PROVIDER_ROUTING_ENABLED=false
SWICO_MODEL_ALIAS_LITE_FAST=openai:gpt-5.4-nano
SWICO_MODEL_ALIAS_LITE_MULTILINGUAL=sarvam:sarvam-105b
SWICO_MODEL_ALIAS_STANDARD_BALANCED=openai:gpt-5.6-terra
SWICO_MODEL_ALIAS_STANDARD_MULTILINGUAL=sarvam:sarvam-105b
SWICO_MODEL_ALIAS_PRO_REASONING=openai:gpt-5.6-sol
SWICO_MODEL_ALIAS_PRO_MULTILINGUAL=sarvam:sarvam-105b
SWICO_MODEL_ALIAS_VISION_PRIMARY=openai:gpt-5.5
SWICO_MODEL_ALIAS_EMBEDDING_PRIMARY=openai:text-embedding-3-small
OPENAI_DISABLE_HIGHEST_MODEL=true
# Swico's internal provider admission budget for each UTC day. This is
# independent of the provider account/organization spend limit; 0 disables
# only this internal guard. Render owns the deployed value.
OPENAI_DAILY_BUDGET_USD=5
# Applied to estimated call cost before the internal budget admits a request.
OPENAI_BUDGET_SAFETY_MARGIN_RATIO=0.05
OPENAI_MAX_OUTPUT_TOKENS_DEFAULT=450
OPENAI_MAX_OUTPUT_TOKENS_HARD=6000
OPENAI_REASONING_EFFORT_SIMPLE=none
OPENAI_REASONING_EFFORT_NORMAL=low
OPENAI_REASONING_EFFORT_DETAILED=low
OPENAI_REASONING_EFFORT_LONG_FORM=low
OPENAI_REASONING_MIN_BUDGET_TOKENS=2000
OPENAI_REASONING_MAX_BUDGET_FRACTION=0.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_PRICE_GPT_5_NANO_INPUT_PER_1M=0.05
OPENAI_PRICE_GPT_5_NANO_CACHED_INPUT_PER_1M=0.005
OPENAI_PRICE_GPT_5_NANO_OUTPUT_PER_1M=0.40
OPENAI_PRICE_GPT_5_MINI_INPUT_PER_1M=0.25
OPENAI_PRICE_GPT_5_MINI_CACHED_INPUT_PER_1M=0.025
OPENAI_PRICE_GPT_5_MINI_OUTPUT_PER_1M=2.00
OPENAI_PRICING_AS_OF=2026-07-17
OPENAI_PRICE_GPT_5_4_MINI_INPUT_PER_1M=0.75
OPENAI_PRICE_GPT_5_4_MINI_CACHED_INPUT_PER_1M=0.075
OPENAI_PRICE_GPT_5_4_MINI_OUTPUT_PER_1M=4.50
OPENAI_PRICE_GPT_5_4_NANO_INPUT_PER_1M=0.20
OPENAI_PRICE_GPT_5_4_NANO_CACHED_INPUT_PER_1M=0.02
OPENAI_PRICE_GPT_5_4_NANO_OUTPUT_PER_1M=1.25
OPENAI_PRICE_GPT_5_5_INPUT_PER_1M=5.00
OPENAI_PRICE_GPT_5_5_CACHED_INPUT_PER_1M=0.50
OPENAI_PRICE_GPT_5_5_OUTPUT_PER_1M=30.00
OPENAI_PRICE_GPT_5_6_TERRA_INPUT_PER_1M=2.50
OPENAI_PRICE_GPT_5_6_TERRA_CACHED_INPUT_PER_1M=0.25
OPENAI_PRICE_GPT_5_6_TERRA_OUTPUT_PER_1M=15.00
OPENAI_PRICE_GPT_5_6_SOL_INPUT_PER_1M=5.00
OPENAI_PRICE_GPT_5_6_SOL_CACHED_INPUT_PER_1M=0.50
OPENAI_PRICE_GPT_5_6_SOL_OUTPUT_PER_1M=30.00
OPENAI_PRICE_GPT_4_1_NANO_INPUT_PER_1M=0.10
OPENAI_PRICE_GPT_4_1_NANO_CACHED_INPUT_PER_1M=0.025
OPENAI_PRICE_GPT_4_1_NANO_OUTPUT_PER_1M=0.40
OPENAI_PRICE_GPT_4_1_MINI_INPUT_PER_1M=0.40
OPENAI_PRICE_GPT_4_1_MINI_CACHED_INPUT_PER_1M=0.10
OPENAI_PRICE_GPT_4_1_MINI_OUTPUT_PER_1M=1.60
OPENAI_PRICE_GPT_4O_MINI_INPUT_PER_1M=0.15
OPENAI_PRICE_GPT_4O_MINI_CACHED_INPUT_PER_1M=0.075
OPENAI_PRICE_GPT_4O_MINI_OUTPUT_PER_1M=0.60
OPENAI_PRICE_O4_MINI_INPUT_PER_1M=1.10
OPENAI_PRICE_O4_MINI_CACHED_INPUT_PER_1M=0.275
OPENAI_PRICE_O4_MINI_OUTPUT_PER_1M=4.40
OPENAI_PRICE_GPT_3_5_TURBO_0125_INPUT_PER_1M=0.50
OPENAI_PRICE_GPT_3_5_TURBO_0125_OUTPUT_PER_1M=1.50
OPENAI_PRICE_TEXT_EMBEDDING_3_SMALL_INPUT_PER_1M=0.02
OPENAI_PRICE_TEXT_EMBEDDING_3_SMALL_OUTPUT_PER_1M=0
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_CHAT_MODEL_REASONING=sarvam-105b
SARVAM_CHAT_MAX_TOKENS=4096
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
WEB_STT_MODE=transcribe
# Official SDK message-envelope value; connection codec remains raw pcm_s16le.
SARVAM_STT_STREAM_MESSAGE_ENCODING=audio/wav
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_MODEL_PREMIUM=bulbul:v3
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_SPEAKER_EN=anushka
SARVAM_TTS_SPEAKER_TA=karun
SARVAM_TTS_PACE_EN=0.95
SARVAM_TTS_PACE_TA=0.9
SARVAM_TTS_LANGUAGE=ta-IN
VOICE_ONLY_PUBLIC_MODE=true
AI_TEXT_CHAT_ENABLED=false
DEFAULT_SPEECH_LANGUAGE=ta-IN
DEFAULT_REPLY_LANGUAGE=ta
SARVAM_PRICE_30B_INPUT_INR_PER_1M=2.5
SARVAM_PRICE_30B_OUTPUT_INR_PER_1M=10
SARVAM_PRICE_105B_INPUT_INR_PER_1M=29.28
SARVAM_PRICE_105B_OUTPUT_INR_PER_1M=73.2
SARVAM_PRICE_STT_INR_PER_HOUR=30
SARVAM_PRICE_TTS_V2_INR_PER_10K_CHARS=15
SARVAM_PRICE_TTS_V3_INR_PER_10K_CHARS=30
AI_ROUTER_ENABLED=true
AI_LEGACY_PIPELINE_ENABLED=false
AI_PROVIDER_ROUTING_MODE=cost_optimized
AI_DEFAULT_ANSWER_STYLE=mobile_concise
AI_DEFAULT_MAX_BULLETS=5
AI_DEFAULT_MAX_PARAGRAPHS=3
AI_DETAILED_ANSWER_TRIGGERS=explain fully,detail,step by step,full architecture,complete code,deep dive
AI_MAX_PROVIDER_CALLS_PER_TURN=1
AI_MAX_PROVIDER_CALLS_PER_TURN_HARD=2
AI_ALLOW_OPENAI_TO_SARVAM_FALLBACK=false
AI_ALLOW_SARVAM_COMPLEX_FALLBACK=false
AI_DAILY_BUDGET_INR=0
SARVAM_DAILY_BUDGET_INR=0
FREE_DAILY_TEXT_LIMIT=40
FREE_DAILY_VOICE_SECONDS=180
ENABLE_WEB_SEARCH_FOR_FREE=false
# Paid website current-information lookup. Backend-only; Free and guests
# remain local-only. Set WEB_LIVE_SEARCH_ENABLED=true only after validation.
WEB_LIVE_SEARCH_ENABLED=false
WEB_LIVE_SEARCH_PROVIDER=openai
WEB_LIVE_SEARCH_MODEL=gpt-4.1-mini
WEB_LIVE_SEARCH_TIMEOUT_SECONDS=15
WEB_LIVE_SEARCH_MAX_CALLS_PER_TURN=1
WEB_LIVE_SEARCH_MAX_OUTPUT_TOKENS=1000
ENABLE_OPENAI_FILE_SEARCH=false
ENABLE_OPENAI_MODERATION=false
ENABLE_ADMIN_AI_PROBE=false
AI_EMBEDDINGS_ON_EVERY_TURN=false
AI_MAX_EMBEDDING_CALLS_PER_TURN=1
AI_SEMANTIC_CACHE_LOOKUP_ENABLED=true
AI_SEMANTIC_CACHE_LOOKUP_FOR_SIMPLE_CHAT=false
AI_RAG_LOOKUP_FOR_SIMPLE_CHAT=false
AI_EMBED_POST_RESPONSE_ASYNC=false
AI_EMBED_POST_RESPONSE_BATCH=true
AI_ROUTER_GLOBAL_CACHE_LOOKUP_ENABLED=true
AI_ROUTER_GLOBAL_CACHE_RECORD_ENABLED=true
USER_QA_SYNC_MIN_HITS=2
USER_QA_SYNC_TTL_DAYS=30
DATABASE_URL=sqlite:///data/db/ai_tool.sqlite3
# For Postgres, prefer psycopg 3:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
# Billing maintenance requires PostgreSQL by default. This override is only for
# explicit local automated tests/development and is always rejected in prod.
BILLING_MAINTENANCE_ALLOW_SQLITE=false
AUTH_ALLOW_DEV_TOKENS=true
# Production must configure exactly one Firebase Admin credential method.
# Recommended on Render: create the secret file firebase-admin.json, set
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-admin.json, and leave
# FIREBASE_CREDENTIALS_JSON unset/empty.
FIREBASE_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Backend-only SMTP/OTP configuration. Do not copy these values into mobile
# Expo env or app config, and do not commit real .env files.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
EMAIL_OTP_SECRET=
# Local/dev only. Production must keep EMAIL_OTP_DEV_RETURN_CODE=false.
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_COOLDOWN_SECONDS=60
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_DEV_RETURN_CODE=false
ADMIN_EMAILS=hari@example.com,admin@example.com
SWICO_INTERNAL_TEST_EMAILS=
# Backend-only, exact verified account emails. Disabled by default; the
# allowance is a calendar-week Chat credit in INR micros (Monday UTC reset).
SWICO_WEEKLY_TESTER_CREDITS_ENABLED=false
SWICO_WEEKLY_TESTER_EMAILS=
SWICO_WEEKLY_TESTER_ALLOWANCE_RUPEES=40
DEBUG_ADMIN_TOKEN=
DOWNLOAD_TOKEN_SECRET=
VECTOR_STORE_BACKEND=auto
GLOBAL_QA_CACHE_ENABLED=true
GLOBAL_QA_PROMOTE_HITS=2
GLOBAL_QA_MIN_SIMILARITY=0.90
GLOBAL_QA_REQUIRE_DISTINCT_USERS=true
GLOBAL_QA_TTL_DAYS=180
GLOBAL_QA_EMBEDDING_PROVIDER=token_hash
GLOBAL_QA_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
GLOBAL_QA_QWEN_EMBEDDING_URL=
GLOBAL_QA_REAL_EMBEDDINGS_ENABLED=false
AUTO_CREATE_TABLES=true
FAIL_STARTUP_ON_REQUIRED_SERVICE_ERROR=false
# Development may run migrations during startup. Render production must set
# both flags false because the documented pre-deploy command owns migrations.
RUN_MIGRATIONS_ON_STARTUP=true
REQUIRE_MIGRATIONS_BEFORE_STARTUP=true
MIGRATION_STARTUP_GRACE_SECONDS=120
MIGRATION_STARTUP_TIMEOUT_SECONDS=120
# Local backend development defaults. Production must use exact HTTPS origins.
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Optional hosted-backend exception for the local Vite frontend only. Keep
# empty unless explicitly enabling local frontend -> hosted backend access.
CORS_ALLOW_LOCAL_DEV_ORIGINS=
# Hosted-backend developer value, when explicitly enabled:
# CORS_ALLOW_LOCAL_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Standalone web application. Keep API Root Directory blank on Render because
# backend/config.py and app/agentic_service.py still read repository mobile/data.
WEB_APP_ENABLED=false
WEB_CHAT_RATE_LIMIT_PER_MINUTE=12
WEB_CANCELLATION_WAIT_SECONDS=10
# Backend-only deterministic website Token Guardian. These are service-level
# ai_tool settings; never copy them to the static site or a shared env group.
WEB_TURN_OPTIMIZER_ENABLED=true
# Phase 0/1 TRIAG-RAG foundations. Disabled is the production-safe default.
# Shadow mode records only bounded, content-free planning metadata when both
# WEB_TRIAG_ENABLED and WEB_TRIAG_SHADOW_MODE are true.
WEB_TRIAG_ENABLED=false
WEB_TRIAG_SHADOW_MODE=true
WEB_TRIAG_POLICY_VERSION=v1
# Controlled retains blanket cache suppression for live rollout cohorts.
# Use general_availability only for an explicitly approved all-eligible release.
WEB_TRIAG_RELEASE_STATE=controlled
# Phase 6A server-authoritative cohorts. Allowed modes are exactly:
# disabled, internal_accounts, percentage, all_eligible. Only percentage mode
# accepts a non-zero percentage (0 through 100); every other mode requires 0.
# Global Phase 0-5 flags remain hard kill switches, so a cohort never enables
# a globally disabled feature.
WEB_ROLLOUT_POLICY_VERSION=v1
WEB_ROLLOUT_TRIAG_MODE=disabled
WEB_ROLLOUT_TRIAG_PERCENT=0
WEB_ROLLOUT_KNOWLEDGE_MODE=disabled
WEB_ROLLOUT_KNOWLEDGE_PERCENT=0
WEB_ROLLOUT_REPOSITORY_MODE=disabled
WEB_ROLLOUT_REPOSITORY_PERCENT=0
WEB_ROLLOUT_ANSWER_GUARD_MODE=disabled
WEB_ROLLOUT_ANSWER_GUARD_PERCENT=0
# Phase 6B verified-admin/Render Shell reporting. This is read-only and never
# changes rollout modes or global feature flags.
WEB_TRIAG_ROLLOUT_REPORT_ENABLED=false
WEB_TRIAG_ROLLOUT_REPORT_DEFAULT_WINDOW_HOURS=24
WEB_TRIAG_ROLLOUT_REPORT_MAX_WINDOW_HOURS=168
WEB_TRIAG_ROLLOUT_ACCEPTANCE_MIN_SAMPLE=20
WEB_RAG_HYBRID_ENABLED=false
WEB_RAG_DENSE_ENABLED=false
WEB_RAG_RETRIEVAL_EVALUATOR_ENABLED=false
WEB_RAG_MAX_CORRECTIVE_ROUNDS=2
WEB_RAG_QUERY_EMBEDDING_CACHE_TTL_SECONDS=86400
WEB_RAG_EMBEDDING_MODEL=text-embedding-3-small
WEB_RAG_EMBEDDING_DIMENSIONS=1536
# Phase 5/5.1 is backend-only. When the full runtime gate is enabled,
# authenticated clients discover the Knowledge Library through bootstrap and
# must explicitly approve each owner-scoped temporary upload. Nothing is
# promoted automatically; temporary uploads still expire independently.
WEB_RAG_PERSISTENT_KNOWLEDGE_ENABLED=false
WEB_RAG_TRIPLET_ENABLED=false
WEB_RAG_HIERARCHY_ENABLED=false
WEB_KNOWLEDGE_JOB_BATCH_SIZE=50
# Dedicated knowledge worker separation. False preserves the existing shared
# worker behavior; true makes the shared worker exclude the four knowledge job
# types and requires a separately running `python -m app.knowledge_worker`.
WEB_KNOWLEDGE_WORKER_ENABLED=false
WEB_KNOWLEDGE_WORKER_POLL_SECONDS=2
WEB_KNOWLEDGE_WORKER_MAX_CONCURRENCY=1
WEB_RAG_LITE_CANDIDATE_LIMIT=12
WEB_RAG_LITE_EVIDENCE_ITEM_LIMIT=4
WEB_RAG_LITE_EVIDENCE_TOKEN_CAP=1200
WEB_RAG_STANDARD_CANDIDATE_LIMIT=30
WEB_RAG_STANDARD_EVIDENCE_ITEM_LIMIT=7
WEB_RAG_STANDARD_EVIDENCE_TOKEN_CAP=3200
WEB_RAG_PRO_CANDIDATE_LIMIT=60
WEB_RAG_PRO_EVIDENCE_ITEM_LIMIT=12
WEB_RAG_PRO_EVIDENCE_TOKEN_CAP=6000
WEB_ANSWER_GUARD_ENABLED=false
WEB_VERIFIED_STREAMING_ENABLED=false
WEB_ANSWER_GUARD_MODEL_VERIFIER_ENABLED=false
WEB_ANSWER_GUARD_REPAIR_ENABLED=false
# Defaults to false when omitted. Production should set this to true so one
# additional bounded repair can correct residual deterministic task semantics
# or a reduced architecture section set; no request can exceed two repairs.
WEB_TASK_REPAIR_SECOND_ATTEMPT_ENABLED=true
WEB_ANSWER_GUARD_MAX_BUFFER_CHARACTERS=200000
# Phase 4 repository snapshots use a dedicated ZIP-only endpoint. Raw source
# stays in WEB_UPLOAD_CACHE_URL for this TTL; these values are backend-only.
WEB_REPOSITORY_UPLOAD_ENABLED=false
WEB_REPOSITORY_TTL_SECONDS=3600
WEB_REPOSITORY_MAX_ARCHIVE_BYTES=26214400
WEB_REPOSITORY_MAX_UNCOMPRESSED_BYTES=104857600
WEB_REPOSITORY_MAX_FILES=5000
WEB_REPOSITORY_MAX_COMPRESSION_RATIO=100
WEB_REPOSITORY_RATE_LIMIT_PER_MINUTE=3
WEB_RAG_REPOSITORY_INDEX_ENABLED=false
WEB_PRO_CODE_VALIDATION_ENABLED=false
WEB_CODE_VALIDATOR_URL=
WEB_CODE_VALIDATOR_AUTH_TOKEN=
WEB_CODE_VALIDATOR_TIMEOUT_SECONDS=90
# Optional cost optimization; keep disabled unless rollout monitoring is active.
WEB_SIMPLE_TURN_TIER_DOWNSHIFT_ENABLED=false
# Same-thread continuity: off | explicit_only | adaptive | always_last.
# Keep the code/development default conservative; enable adaptive deliberately in Render.
WEB_SAME_THREAD_CONTEXT_MODE=explicit_only
# Backend-only deterministic public identity route. Keep this directly on the
# ai_tool API service; do not copy it to web/VITE values or shared services.
WEB_SWICO_BRAND_GUARD_ENABLED=true
WEB_CONTEXT_MAX_TURNS=2
WEB_CONTEXT_MAX_CHARS=900
WEB_PROFILE_PROMPT_MAX_CHARS=500
WEB_ATTACHMENT_PROMPT_MAX_CHARS=6000
WEB_SIMPLE_MAX_OUTPUT_TOKENS=220
WEB_NORMAL_MAX_OUTPUT_TOKENS=420
WEB_DETAILED_MAX_OUTPUT_TOKENS=1800
WEB_LONG_FORM_MAX_OUTPUT_TOKENS=6000
WEB_PROVIDER_CALLS_PER_TURN_MAX=1
WEB_PROMPT_TOKEN_BREAKDOWN_ENABLED=true
WEB_CACHE_BEFORE_BILLING_ENABLED=true
# Explicit provider prompt caching stays off until cache-write usage and
# pricing are supported and settled without undercharging.
WEB_PROMPT_CACHE_ENABLED=false
WEB_PROMPT_CACHE_VERSION=v1
WEB_MAX_PROVIDER_ATTEMPTS=1
WEB_SSE_HEARTBEAT_SECONDS=10
# Controls editing of the latest active visible website prompt.
WEB_MESSAGE_EDIT_ENABLED=false
WEB_CROSS_THREAD_MEMORY_ENABLED=false
WEB_MEMORY_MAX_ITEMS=2
WEB_MEMORY_MAX_CHARS=1200
WEB_MEMORY_LLM_SUMMARIZATION_ENABLED=false
WEB_LONG_INPUT_ENABLED=false
WEB_LONG_INPUT_INLINE_THRESHOLD_CHARS=12000
WEB_LONG_INPUT_MAX_CHARS=64000
WEB_DOCUMENT_OCR_ENABLED=false
WEB_LEGACY_DOC_CONVERSION_ENABLED=false
# Temporary web documents. Production/staging must use a dedicated Redis/Valkey
# connection here; do not reuse REDIS_URL. Raw document/audio bytes are never stored.
WEB_ATTACHMENTS_ENABLED=false
WEB_IMAGE_UPLOADS_ENABLED=false
WEB_IMAGE_UPLOAD_MAX_BYTES=8388608
WEB_IMAGE_UPLOAD_MAX_COUNT=4
WEB_VOICE_RECORDING_ENABLED=false
WEB_VOICE_REPLY_ENABLED=false
WEB_VOICE_BILLING_ENABLED=false
WEB_REALTIME_VOICE_ENABLED=false
WEB_REALTIME_VOICE_PLAYBACK_MODE=buffered_mp3
SARVAM_TTS_STREAM_OUTPUT_CODEC=mp3
SARVAM_TTS_STREAM_SAMPLE_RATE=24000
WEB_SEPARATE_VOICE_CREDITS_ENABLED=false
WEB_REALTIME_VOICE_SESSION_TICKET_TTL_SECONDS=60
WEB_REALTIME_VOICE_MAX_SESSION_SECONDS=900
WEB_REALTIME_VOICE_IDLE_TIMEOUT_SECONDS=60
WEB_REALTIME_VOICE_MAX_CONCURRENT_SESSIONS_PER_USER=1
WEB_REALTIME_VOICE_START_RATE_LIMIT_PER_MINUTE=5
WEB_REALTIME_VOICE_ADAPTIVE_ENDPOINTING_ENABLED=true
WEB_REALTIME_VOICE_END_SILENCE_MS=1100
WEB_REALTIME_VOICE_UNFINISHED_GRACE_MS=900
WEB_REALTIME_VOICE_MAX_ENDPOINT_WAIT_MS=2600
WEB_REALTIME_VOICE_MIN_SPEECH_MS=250
WEB_REALTIME_VOICE_MAX_UTTERANCE_MS=30000
WEB_REALTIME_VOICE_BARGE_IN_MIN_MS=180
WEB_REALTIME_VOICE_PREROLL_MS=320
WEB_REALTIME_VOICE_BACKCHANNEL_ENABLED=false
WEB_VOICE_GATE_CALIBRATION_MS=400
WEB_VOICE_GATE_NOISE_MULTIPLIER=2.4
WEB_VOICE_GATE_THRESHOLD_MIN=0.012
WEB_VOICE_GATE_THRESHOLD_MAX=0.065
WEB_VOICE_GATE_QUIET_FALLBACK=0.008
WEB_VOICE_NO_SPEECH_WARNING_MS=10000
WEB_UPLOAD_CACHE_URL=
# Manual CLI guard only. Never set this on a service, CI, pytest, or startup.
ALLOW_LIVE_SARVAM_VOICE_PROBE=false
WEB_UPLOAD_TTL_SECONDS=300
WEB_UPLOAD_MAX_FILE_BYTES=10485760
WEB_UPLOAD_MAX_FILES_PER_MESSAGE=5
WEB_UPLOAD_MAX_TOTAL_BYTES=26214400
WEB_UPLOAD_MAX_EXTRACTED_CHARS=100000
WEB_AUDIO_MAX_SECONDS=30
WEB_TTS_MAX_CHARACTERS=5000
WEB_UPLOAD_RATE_LIMIT_PER_MINUTE=10
WEB_STT_RATE_LIMIT_PER_MINUTE=10
WEB_TTS_RATE_LIMIT_PER_MINUTE=10
WEB_UPLOAD_STORE_RAW=false

# Internal prepaid billing units. Customer-facing surfaces call the product
# Token credits and expose model-dependent token estimates, never cash value.
# 1 INR = 1,000,000 micro-INR internally; Razorpay amounts are integer paise.
# Production must set this explicitly. Keep false until checkout is intentionally
# opened; existing balances and AI usage remain available while it is false.
BILLING_CHECKOUT_ENABLED=false
BILLING_CREDIT_PERCENT=50
BILLING_MIN_TOPUP_PAISE=1500
BILLING_MAX_TOPUP_PAISE=50000
BILLING_TOPUP_PACKAGES_PAISE=1500,29900
BILLING_ENFORCE_TOPUP_PACKAGES=false

# Website prepaid subscriptions and referral rewards. These are backend-only;
# the website reads the authoritative values from /api/web/billing/public-config.
WEB_SUBSCRIPTIONS_ENABLED=false
WEB_REFERRALS_ENABLED=false
WEB_SUBSCRIPTION_1M_PRICE_PAISE=150000
WEB_SUBSCRIPTION_6M_PRICE_PAISE=800000
WEB_SUBSCRIPTION_1Y_PRICE_PAISE=1200000
WEB_SUBSCRIPTION_WEEKLY_ALLOWANCE_MICROS=125000000
WEB_SUBSCRIPTION_PRORATE_FINAL_PARTIAL_WEEK=true
WEB_SUBSCRIPTION_PAYG_FALLBACK_DEFAULT=false
WEB_REFERRAL_REWARD_1M_WEEKS=1
WEB_REFERRAL_REWARD_6M_WEEKS=3
WEB_REFERRAL_REWARD_1Y_MONTHS=2
BILLING_RESERVE_MULTIPLIER=1.25
BILLING_STALE_RESERVATION_AGE_SECONDS=1800
# Rows older than this window are covered by the read-only financial audit, not the sweep.
BILLING_RECONCILIATION_MAX_AGE_SECONDS=2592000
USAGE_MARKUP_MULTIPLIER=1.0
USD_TO_INR_BILLING_RATE=90
OPENAI_FX_BUFFER_PERCENT=3
SARVAM_PRICE_30B_CACHED_INPUT_INR_PER_1M=1.5
SARVAM_PRICE_105B_CACHED_INPUT_INR_PER_1M=10.98

# Razorpay secrets are backend-only. RAZORPAY_KEY_ID is public but is still
# served to the browser by /api/web/billing/public-config. A reconciliation Cron
# Job requires MODE, KEY_ID, and KEY_SECRET; it is dry-run unless --apply is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
RAZORPAY_WEBHOOK_MAX_BYTES=262144
RAZORPAY_READ_RETRY_ATTEMPTS=3
RAZORPAY_READ_RETRY_BASE_MS=500
RAZORPAY_READ_RETRY_MAX_MS=4000
RAZORPAY_HTTP_TIMEOUT_SECONDS=15

# Financial audit alerts use the existing PII-disabled Sentry integration.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
# Optional web intelligence rollout (all boolean behaviors default off)
GLOBAL_QA_SEMANTIC_ENABLED=false
GLOBAL_QA_MIN_SIMILARITY=0.90
GLOBAL_QA_EMBEDDING_BACKFILL_BATCH_SIZE=50
GLOBAL_QA_CONFIDENCE_FLOOR=0.35
GLOBAL_QA_CONFIDENCE_MAX=1.0
WEB_MEMORY_FACT_RANKING_ENABLED=false
WEB_MEMORY_FACT_MIN_SIMILARITY=0.35
WEB_DETERMINISTIC_TOOLS_ENABLED=false
WEB_MODEL_LADDER_DOWNGRADE_ENABLED=false
WEB_DETAILED_MIN_TIER=standard
WEB_POST_TURN_DISTILLATION_ENABLED=false
WEB_PROMPT_PREFIX_STABLE_ENABLED=false
WEB_MAX_PROMPT_TOKENS=6000
WEB_CONTEXT_RELEVANCE_RANKING_ENABLED=false
WEB_CONTEXT_CANDIDATE_TURNS=80
WEB_ANSWER_FEEDBACK_ENABLED=false
WEB_CONTENT_SEARCH_ENABLED=false
WEB_RESPONSE_PROVENANCE_ENABLED=false

# Swico CLI rollout (backend-only; keep disabled until the API and website are
# deployed together and readiness has been checked). CLI uses the existing
# Firebase account and Chat billing bucket; these values never grant a billing
# exemption. Empty email allowlist means every eligible verified account once
# the feature is enabled.
SWICO_CLI_ENABLED=false
SWICO_CLI_AGENT_ENABLED=false
SWICO_CLI_WEB_ORIGIN=https://swico.in
SWICO_CLI_ALLOWED_EMAILS=
# Optional local-agent pilot restriction; empty means no additional restriction
# when the agent flag is enabled, while the pilot release gate requires a
# non-empty list for the first controlled rollout.
SWICO_CLI_AGENT_ALLOWED_EMAILS=
SWICO_CLI_MAX_AGENT_STEPS=8
# Cloud execution is fail-closed until a separately isolated runner and job
# capability service have been deployed and reviewed. Never run repositories
# in the API/web process.
SWICO_CLI_CLOUD_AGENT_ENABLED=false
# Configure only for a separately isolated runner; the API never executes repositories.
SWICO_CLI_CLOUD_RUNNER_URL=
SWICO_CLI_CLOUD_RUNNER_TOKEN=
# Deprecated: this boolean is ignored for readiness. The runner must provide
# short-lived signed evidence in SWICO_CLI_CLOUD_RUNNER_ATTESTATION.
SWICO_CLI_CLOUD_RUNNER_HANDSHAKE=false
SWICO_CLI_CLOUD_RUNNER_ATTESTATION=
# The controller uses these values to claim and lease jobs. The controller
# runs separately from the API and must share the runner token only.
SWICO_RUNNER_CONTROL_URL=
SWICO_RUNNER_ID=
SWICO_RUNNER_POLL_SECONDS=5
SWICO_RUNNER_HEARTBEAT_SECONDS=20
# Optional, explicit local-client fallback only; never configure on Render.
# SWICO_CLI_CREDENTIAL_FILE=
