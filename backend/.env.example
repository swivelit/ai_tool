# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
# Production/Render should leave this false by default. Set true only for
# short-lived debugging when redacted question/answer previews are acceptable.
LOG_CHAT_CONTENT=false
LOG_CHAT_CONTENT_MAX_CHARS=240
CLIENT_TURN_LOGS_ENABLED=true
CHAT_TURN_SUMMARY_LOGS_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_JSON_MODEL=gpt-5-nano
OPENAI_MODEL_CHEAP=gpt-5-nano
OPENAI_MODEL_STANDARD=gpt-5-nano
OPENAI_MODEL_REASONING=gpt-5-mini
OPENAI_MODEL_HIGH=
OPENAI_DISABLE_HIGHEST_MODEL=true
OPENAI_DAILY_BUDGET_USD=5
OPENAI_BUDGET_SAFETY_MARGIN_RATIO=0.05
OPENAI_MAX_OUTPUT_TOKENS_DEFAULT=450
OPENAI_MAX_OUTPUT_TOKENS_HARD=900
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_PRICE_GPT_5_NANO_INPUT_PER_1M=0.05
OPENAI_PRICE_GPT_5_NANO_OUTPUT_PER_1M=0.40
OPENAI_PRICE_GPT_5_MINI_INPUT_PER_1M=0.25
OPENAI_PRICE_GPT_5_MINI_OUTPUT_PER_1M=2.00
OPENAI_PRICE_TEXT_EMBEDDING_3_SMALL_INPUT_PER_1M=0.02
OPENAI_PRICE_TEXT_EMBEDDING_3_SMALL_OUTPUT_PER_1M=0
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-30b
SARVAM_CHAT_MODEL_REASONING=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_MODEL_PREMIUM=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE=ta-IN
SARVAM_PRICE_30B_INPUT_INR_PER_1M=2.5
SARVAM_PRICE_30B_OUTPUT_INR_PER_1M=10
SARVAM_PRICE_105B_INPUT_INR_PER_1M=4
SARVAM_PRICE_105B_OUTPUT_INR_PER_1M=16
SARVAM_PRICE_STT_INR_PER_HOUR=30
SARVAM_PRICE_TTS_V2_INR_PER_10K_CHARS=15
SARVAM_PRICE_TTS_V3_INR_PER_10K_CHARS=30
AI_ROUTER_ENABLED=true
AI_LEGACY_PIPELINE_ENABLED=false
AI_PROVIDER_ROUTING_MODE=cost_optimized
AI_MAX_PROVIDER_CALLS_PER_TURN=1
AI_MAX_PROVIDER_CALLS_PER_TURN_HARD=2
AI_ALLOW_OPENAI_TO_SARVAM_FALLBACK=false
AI_ALLOW_SARVAM_COMPLEX_FALLBACK=false
AI_DAILY_BUDGET_INR=0
SARVAM_DAILY_BUDGET_INR=0
FREE_DAILY_TEXT_LIMIT=40
FREE_DAILY_VOICE_SECONDS=180
ENABLE_WEB_SEARCH_FOR_FREE=false
ENABLE_OPENAI_FILE_SEARCH=false
ENABLE_OPENAI_MODERATION=false
DATABASE_URL=sqlite:///data/db/ai_tool.sqlite3
# For Postgres, prefer psycopg 3:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB_NAME
AUTH_ALLOW_DEV_TOKENS=true
FIREBASE_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
ADMIN_EMAILS=hari@example.com,admin@example.com
DEBUG_ADMIN_TOKEN=
DOWNLOAD_TOKEN_SECRET=
VECTOR_STORE_BACKEND=auto
GLOBAL_QA_CACHE_ENABLED=true
GLOBAL_QA_PROMOTE_HITS=2
GLOBAL_QA_MIN_SIMILARITY=0.90
GLOBAL_QA_REQUIRE_DISTINCT_USERS=true
GLOBAL_QA_TTL_DAYS=180
AUTO_CREATE_TABLES=true
FAIL_STARTUP_ON_REQUIRED_SERVICE_ERROR=false
RUN_MIGRATIONS_ON_STARTUP=true
REQUIRE_MIGRATIONS_BEFORE_STARTUP=true
MIGRATION_STARTUP_GRACE_SECONDS=120
MIGRATION_STARTUP_TIMEOUT_SECONDS=120
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
